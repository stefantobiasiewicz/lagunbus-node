{
  "about": "Diagnostics (ep1), Groups (ep2) and the absent Scenes (ep3), which the node serves itself (types/0x0002-diagnostics.md, types/0x0004-groups.md). The frame counters count every frame the node took in or put out, its own replies included.",
  "profile": "key",
  "uid": "A1B2C3D400010203",
  "jitter": 0,
  "store": {"address": "4200"},
  "pin": true,
  "on_start": ["02108001#000000010000"],
  "steps": [
    {"at": 10, "note": "the in-memory port knows no controller counters", "rx": ["0C108100#01"], "expect": ["0E108100#61"]},
    {"at": 20, "note": "TxFrames: Booted and the reply above", "rx": ["0C108104#02"], "expect": ["0E108104#0202000000"]},
    {"at": 30, "note": "RxFrames: this is the third frame in", "rx": ["0C108105#03"], "expect": ["0E108105#0303000000"]},
    {"at": 40, "note": "ErrorThreshold below 16 is refused", "rx": ["0A108120#040A00"], "expect": ["0E108120#34"]},
    {"at": 50, "rx": ["0A108120#056400"], "expect": ["0E108120#05"]},
    {"at": 60, "rx": ["0C108120#06"], "expect": ["0E108120#066400"]},
    {"at": 70, "note": "the counters are read-only", "rx": ["0A108104#070000"], "expect": ["0E108104#27"]},
    {"at": 80, "note": "Diagnostics reports every 300 s by default", "rx": ["0C1081F8#01"], "expect": ["0E1081F8#012C01"]},
    {"at": 90, "rx": ["0A1081F8#023C00"], "expect": ["0E1081F8#02"]},
    {"at": 100, "rx": ["0C1081F8#03"], "expect": ["0E1081F8#033C00"]},
    {"at": 110, "note": "a system endpoint cannot be disabled", "rx": ["0A1081F3#0400"], "expect": ["0E1081F3#34"]},
    {"at": 120, "rx": ["0A1081F3#0501"], "expect": ["0E1081F3#05"]},
    {"at": 130, "note": "QueryEnabled: no inputs, so only 0", "rx": ["0A1081F6#060100"], "expect": ["0E1081F6#36"]},
    {"at": 140, "note": "TypeId of Diagnostics and Groups", "rx": ["0C1081F0#07", "0C1082F0#00"],
     "expect": ["0E1081F0#070200", "0E1082F0#000400"]},
    {"at": 150, "note": "GroupCapacity 0", "rx": ["0C108200#01"], "expect": ["0E108200#0100"]},
    {"at": 160, "note": "Groups commands have nowhere to store", "rx": ["06108201#02"], "expect": ["0E108201#52"]},
    {"at": 170, "rx": ["06108204#03"], "expect": ["0E108204#13"]},
    {"at": 180, "note": "no Scenes endpoint", "rx": ["0C108300#04", "06108300#05", "0A108300#0600"],
     "expect": ["0E108300#0C", "0E108300#0D", "0E108300#0E"]},
    {"at": 190, "note": "Diagnostics has one command", "rx": ["06108101#07"], "expect": ["0E108101#17"]},
    {"at": 200, "note": "Reset zeroes the counters — and its own reply is counted after it",
     "rx": ["06108100#00"], "expect": ["0E108100#00"]},
    {"at": 210, "rx": ["0C108104#01"], "expect": ["0E108104#0101000000"]}
  ]
}
